[Unit]
Description=CADENCE: collect UBI repodata every 4 hours
Documentation=https://github.com/north-echo/cadence/blob/main/docs/operations.md

[Timer]
# Offset from RHSA/CSAF by two hours so repodata polling doesn't collide
# with the RHSA→CSAF chain on the same hourly mark.
OnCalendar=*-*-* 00,04,08,12,16,20:17:00
RandomizedDelaySec=10min
Persistent=true
Unit=cadence-collect-repodata.service

[Install]
WantedBy=timers.target
